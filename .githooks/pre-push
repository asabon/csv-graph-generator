#!/bin/sh
# pre-push: main ブランチへの直接 push を防止する

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        echo "========================================================"
        echo " [ERROR] Direct push or branch deletion on '$remote_ref' is forbidden!"
        echo " Please push to a topic branch and create a Pull Request."
        echo "   e.g.) git push -u origin feature/your-feature-name"
        echo "========================================================"
        exit 1
    fi
done

exit 0
